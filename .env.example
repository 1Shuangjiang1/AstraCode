# DeepSeek 官方 Anthropic-compatible API（推荐配置）。
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_API_KEY=
S_FULL_MODEL=deepseek-v4-flash
# 对话命名单独关闭思考、只生成极短标题；未配置时使用首条消息截取。
# 对话命名走独立的硅基流动 OpenAI-compatible API，不影响主 Agent。
S_FULL_TITLE_MODEL=deepseek-ai/DeepSeek-V4-Flash
S_FULL_TITLE_BASE_URL=https://api.siliconflow.cn/v1
S_FULL_TITLE_API_KEY=
S_FULL_THINKING=1
# 正式版仅区分 high / max；low、medium 会被服务端映射为 high。
S_FULL_REASONING_EFFORT=high

# 也可使用 DEEPSEEK_API_KEY；优先级低于 ANTHROPIC_API_KEY。
# DEEPSEEK_API_KEY=sk-your-deepseek-api-key
# 兼容旧配置：MODEL_ID=deepseek-v4-flash

# 可选运行参数。
S_FULL_API_TIMEOUT=300
S_FULL_COMMAND_TIMEOUT=30
S_FULL_TOKEN_THRESHOLD=100000
S_FULL_MAX_OUTPUT_TOKENS=32768
S_FULL_MAX_ROUNDS=8
S_FULL_MAX_SECONDS=300
S_FULL_VISUAL=1
S_FULL_TRACE_INPUT_LIMIT=900
S_FULL_TRACE_OUTPUT_LIMIT=1200

# 权限模式：safe / approval / full_access。
S_FULL_PERMISSION_MODE=approval
# 即使 full_access，关机、格式化磁盘、删除根目录等仍默认硬拦截。
S_FULL_ALLOW_CRITICAL=0

# 离线模式：不创建真实 API client，不产生网络请求或费用。
S_FULL_FAKE_CLIENT=0
S_FULL_POLL_INTERVAL=5
S_FULL_IDLE_TIMEOUT=60
